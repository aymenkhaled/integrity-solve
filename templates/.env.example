# ============================================================================
# Integrity Solve — Environment Variables
# Copy to .env (DO NOT COMMIT) and fill in. Use Replit Secrets in production.
# ============================================================================

# ----- Phase 0 — Bootstrap (REQUIRED at startup) -----
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=change_me_to_64_random_chars  # openssl rand -base64 64

# ----- Phase 1 — Auth + email -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                   # Gmail app password (NOT account password)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Integrity Solve

# ----- Phase 2 — File storage (R2) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=integrity-solve
R2_PUBLIC_URL_BASE=

# ----- Phase 3 — SMS (Twilio) — defer until reaching mobile OTP -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ----- Phase 4 — Stripe -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_GROUP=price_...
STRIPE_PRICE_LIFETIME=price_...
STRIPE_PRICE_USAGE_CHECK=price_...

# ----- Phase 4 — Providers -----
FACIA_API_KEY=
FACIA_WEBHOOK_SECRET=
FACIA_BASE_URL=https://api.facia.com/v2

AML_WATCHER_API_KEY=
AML_WATCHER_WEBHOOK_SECRET=
AML_WATCHER_BASE_URL=https://api.amlwatcher.com

# ABR is free — register for a GUID at https://abr.business.gov.au/Tools/WebServicesGuide
ABR_GUID=

# ----- Phase 5 — Monitoring -----
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=integrity-solve

# ----- Diamond features -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional — Redis for BullMQ (in-process scheduler used as fallback if not set)
REDIS_URL=

# Optional — landing page extras
CRISP_WEBSITE_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# Diamond 7 — Customer portal
CUSTOMER_PORTAL_URL=http://localhost:5000/customer-portal
CUSTOMER_PORTAL_FROM_EMAIL=
